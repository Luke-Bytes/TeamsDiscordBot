APP_ID=<YOUR_APP_ID>
BOT_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>
DATABASE_URL=<YOUR_MONGODB_URL>
DATABASE_BACKUP_URL=<YOUR_MONGODB_URL>

# Minecraft username history (MCProfiles enabled by default; others require credentials)
# MC_NAME_HISTORY_MCPROFILES_ENABLED=false
# BISAI_API_KEY=<YOUR_API_KEY>
# MC_NAME_HISTORY_BISAI_ENABLED=false
# LABY_API_TOKEN=<AUTHORIZED_ORGANIZATION_API_READ_TOKEN>
# WINSTREAK_API_KEY=<YOUR_API_KEY>
# MC_NAME_HISTORY_LABY_ENABLED=false
# MC_NAME_HISTORY_WINSTREAK_ENABLED=false
# MC_NAME_HISTORY_SUPPRESSED_UUIDS=<COMMA_SEPARATED_UUIDS>

# /ask credentials (optional: supply at least one if config.ai.enabled is true)
# MC_AI_GROQ_KEY=<YOUR_GROQ_API_KEY>
# MC_AI_GEMINI_KEY=<YOUR_GEMINI_API_KEY>
# MC_AI_CLOUDFLARE_KEY=<YOUR_CLOUDFLARE_WORKERS_AI_TOKEN>
