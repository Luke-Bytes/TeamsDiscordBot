generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Independent of games, seasons and Elo. Form JSON uses stable question IDs.
model StandaloneEvent {
  id String @id @default(uuid()) @map("_id")
  guildId String
  title String
  description String
  startsAt DateTime?
  terms String
  questions Json
  formRevision Int @default(0)
  revision Int @default(0)
  state String @default("DRAFT")
  capacity Int?
  signupDeadline DateTime?
  openedAt DateTime?
  finishedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  signups EventSignup[]

  @@index([guildId, createdAt])
}

model EventSignup {
  id String @id @default(uuid()) @map("_id")
  eventId String
  event StandaloneEvent @relation(fields: [eventId], references: [id])
  discordUserId String
  minecraftUUID String
  minecraftUsername String
  answers Json
  acceptedFormRevision Int
  acceptedTermsAt DateTime
  status String
  queuedAt DateTime
  confirmedAt DateTime?
  withdrawnAt DateTime?
  roleSyncPending Boolean @default(true)
  promotionPending Boolean @default(false)
  promotionNotifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, discordUserId])
  @@index([eventId, status, queuedAt])
}

model EventGuildState {
  id String @id @default(uuid()) @map("_id")
  guildId String @unique
  currentEventId String?
  revision Int @default(0)
}

model Season {
  id        String      @id @default(uuid()) @map("_id")
  number    Int         @unique
  name      String?
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean     @default(true)
  type      SeasonType? @default(RANKED)

  gameLimit        Int?
  monthLimit       Float?
  rankedGameLimit  Int?
  rankedMonthLimit Float?
  firstRolloverAt  DateTime?
  rolloverDeadline DateTime?
  rolloverPending  Boolean?    @default(false)
  nextTypeOverride SeasonType?

  lifecycleState     SeasonLifecycleState? @default(ACTIVE)
  lifecycleToken     String?
  closureReason      SeasonClosureReason?
  closureRequestedAt DateTime?
  closedAt           DateTime?
  successorSeasonId  String?
  titlesProcessedAt  DateTime?
  recapProcessedAt   DateTime?

  games              Game[]
  gameParticipations GameParticipation[]
  eloHistories       EloHistory[]
  playerStats        PlayerStats[]
  announcements      SeasonAnnouncement[]
}

model SeasonAnnouncement {
  id               String                    @id @default(uuid()) @map("_id")
  seasonId         String
  season           Season                    @relation(fields: [seasonId], references: [id])
  kind             SeasonAnnouncementKind
  blockIndex       Int
  marker           String
  content          String
  state            AnnouncementDeliveryState @default(PENDING)
  discordMessageId String?
  attempts         Int                       @default(0)
  lastAttemptAt    DateTime?
  deliveredAt      DateTime?
  lastError        String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([seasonId, kind, blockIndex])
  @@index([state, createdAt])
}

model PlayerStats {
  id       String  @id @default(uuid()) @map("_id")
  playerId String
  player   Player? @relation(fields: [playerId], references: [id])

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elo                 Int @default(1000)
  wins                Int @default(0)
  losses              Int @default(0)
  winStreak           Int @default(0)
  loseStreak          Int @default(0)
  biggestWinStreak    Int @default(0)
  biggestLosingStreak Int @default(0)

  @@unique([playerId, seasonId])
  @@index([seasonId, elo])
}

model Player {
  id String @id @default(uuid()) @map("_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discordSnowflake String @unique

  minecraftAccounts       String[]
  primaryMinecraftAccount String?
  latestIGN               String?

  eloHistories EloHistory[]
  games        GameParticipation[]
  punishments  PlayerPunishment[]
  PlayerStats  PlayerStats[]
  profile      Profile?

  @@index([latestIGN])
}

model Game {
  id       String  @id @default(uuid()) @map("_id")
  finished Boolean @default(false)

  startTime     DateTime
  endTime       DateTime
  settings      GameSettings
  winner        Team
  type          gameType?
  doubleElo     Boolean?
  organiserNoElo Boolean? @default(false)
  scenarioId     String?
  scenarioVersion Int?
  scenarioMetadata Json?
  eloRated      Boolean?           @default(true)
  unratedReason UnratedGameReason?

  organiser String
  host      String

  participantsIGNs String[]
  redTeamPlan      Json?
  blueTeamPlan     Json?
  // Immutable payload digest for recognising a completed retry by match ID.
  persistenceFingerprint String?
  // PENDING is persisted in the match transaction; COMPLETE only after cleanup.
  cleanupState MatchCleanupState?
  cleanupCompletedAt DateTime?

  eloHistories       EloHistory[]
  gameParticipations GameParticipation[]

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])
}

model GameParticipation {
  id String @id @default(uuid()) @map("_id")

  ignUsed            String
  team               Team
  draftSlotPlacement Int?

  playerId String
  gameId   String
  player   Player @relation(fields: [playerId], references: [id])
  game     Game   @relation(fields: [gameId], references: [id])

  mvp          Boolean  @default(false)
  captain      Boolean  @default(false)
  votedForAMVP Boolean? @default(false)

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, gameId])
  @@index([gameId])
}

model EloHistory {
  id       String @id @default(uuid()) @map("_id")
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())
  elo       Int

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, gameId])
  @@index([playerId, seasonId, createdAt])
}

type ModifierTypes {
  category String
  name     String
}

type BanList {
  RED  AnniClass[]
  BLUE AnniClass[]
}

type GameSettings {
  organiserBannedClasses        AnniClass[]
  sharedCaptainBannedClasses    AnniClass[]
  nonSharedCaptainBannedClasses BanList?
  map                           AnniMap
  modifiers                     ModifierTypes[]
  delayedBan                    Int             @default(0)
}

model PlayerPunishment {
  id String @id @default(uuid()) @map("_id")

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  reasons          String[]
  strikeCount      Int
  punishmentDates  DateTime[]
  punishmentExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TemporaryVoiceChannel {
  id String @id @default(uuid()) @map("_id")

  guildId    String
  channelId  String @unique
  ownerId    String
  categoryId String

  name       String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  autoLockAt DateTime?

  locked         Boolean  @default(false)
  invitedUserIds String[] @default([])

  @@unique([guildId, ownerId])
  @@index([expiresAt])
}

enum MatchCleanupState {
  PENDING
  COMPLETE
}

enum Team {
  RED
  BLUE
}

enum SeasonType {
  RANKED
  RELAXED
}

enum SeasonLifecycleState {
  ACTIVE
  CLOSING
  CLOSED
}

enum SeasonClosureReason {
  GAME_LIMIT
  MONTH_LIMIT
  MANUAL
  SCHEDULED
}

enum SeasonAnnouncementKind {
  RECAP
  TITLES
  NEW_SEASON
}

enum AnnouncementDeliveryState {
  PENDING
  DELIVERED
}

enum UnratedGameReason {
  RELAXED_SEASON
  LOW_PLAYER_COUNT
  ORGANISER_SELECTED
}

enum gameType {
  DRAFT
  SNAKE_DRAFT
  RANDOMISED
  ELO
  BALANCE
}

model Profile {
  id String @id @default(uuid()) @map("_id")

  playerId String @unique
  player   Player @relation(fields: [playerId], references: [id])

  preferredName  String?
  title          String?
  unlockedTitles String[]    @default([])
  // Optional for existing profiles that predate this setting; missing means on.
  autoNickname   Boolean?    @default(true)
  pronouns       Pronouns?
  languages      Language[]
  region         Region?
  rank           PlayerRank?

  preferredRoles    Role[]
  proficientAtRoles Role[]
  improveRoles      Role[]

  playstyles Playstyle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Pronouns {
  HE_HIM
  SHE_HER
  THEY_THEM
  ANY
  ASK
}

